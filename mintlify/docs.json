{
  "$schema": "https://mintlify.com/docs.json",
  "name": "LPData",
  "theme": "mint",
  "colors": {
    "primary": "#14b8a6",
    "light": "#2dd4bf",
    "dark": "#0d9488"
  },
  "logo": {
    "light": "/logo/light.svg",
